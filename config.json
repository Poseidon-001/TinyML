{
    "//": "Basics",
    "DESIGN_NAME": "Random_forest_top_ver3",
    "VERILOG_FILES": "dir::src/*.v",
    "CLOCK_PERIOD": 10,
    "CLOCK_PORT": "clk",
    "PNR_SDC_FILE": "dir::src/Random_forest_top_ver3.sdc",
    "SIGNOFF_SDC_FILE": "dir::src/Random_forest_top_ver3.sdc",
    "RUN_MAGIC_DRC": true,
    "RUN_MAGIC_LVS": true,

    "//": "Synthesis",
    "SYNTH_STRATEGY": "AREA 0",
    "MAX_FANOUT_CONSTRAINT": 8,
    "SYNTH_BUFFERING": true,
    "SYNTH_SIZING": true,

    "//": "Floorplan",
    "FP_CORE_UTIL": 40,
    "FP_ASPECT_RATIO": 1,
    "FP_IO_MODE": 1,
    "FP_CORE_MARGIN": 2,

    "//": "Placement",
    "PL_TARGET_DENSITY": 0.45,
    "PL_RESIZER_TIMING_OPTIMIZATIONS": true,
    "PL_RESIZER_DESIGN_OPTIMIZATIONS": true,
    "PL_RESIZER_BUFFER_INPUT_PORTS": true,
    "PL_RESIZER_BUFFER_OUTPUT_PORTS": true,
    "PL_MAX_DISPLACEMENT_X": 500,
    "PL_MAX_DISPLACEMENT_Y": 500,

    "//": "CTS",
    "CTS_STRATEGY": "17",
    "CTS_TARGET_SKEW": 50,
    "CTS_CLK_MAX_WIRE_LENGTH": 200,
    "CTS_CLK_BUFFER_LIST": "sky130_fd_sc_hd__clkbuf_1 sky130_fd_sc_hd__clkbuf_2 sky130_fd_sc_hd__clkbuf_4",

    "//": "Routing",
    "GRT_ADJUSTMENT": 0.3,
    "GRT_ALLOW_CONGESTION": true,
    "DRT_OPT_ITERS": 64,
    "ROUTING_CORES": 4,
    "GRT_REPAIR_ANTENNAS": true,
    "DIODE_ON_PORTS": "in",
    "RUN_HEURISTIC_DIODE_INSERTION": true,
    "GRT_OVERFLOW_ITERS": 50,
    "GRT_ANT_ITERS": 15,

    "//": "PDN",
    "FP_PDN_VOFFSET": 5,
    "FP_PDN_HOFFSET": 5,
    "FP_PDN_VWIDTH": 3,
    "FP_PDN_HWIDTH": 3,
    "FP_PDN_VPITCH": 30,
    "FP_PDN_HPITCH": 30,
    "FP_PDN_SKIPTRIM": true,

    "//": "Pin Order",
    "FP_PIN_ORDER_CFG": "dir::pin_order.cfg",

    "//": "Technology-Specific Configs",
    "pdk::sky130*": {
        "FP_CORE_UTIL": 40,
        "CLOCK_PERIOD": 10,
        "scl::sky130_fd_sc_hs": {
            "CLOCK_PERIOD": 10,
            "MAX_FANOUT_CONSTRAINT": 8
        },
        "scl::sky130_fd_sc_ls": {
            "MAX_FANOUT_CONSTRAINT": 6
        }
    },
    "pdk::gf180mcu*": {
        "CLOCK_PERIOD": 10.0,
        "FP_CORE_UTIL": 40,
        "MAX_FANOUT_CONSTRAINT": 8,
        "PL_TARGET_DENSITY": 0.45
    }
}
